# Copiar a .env y completar los valores marcados como requeridos — .env
# nunca se commitea, tiene que estar en .gitignore.

APP_NAME=HuriosCan

# Opcional — default si no se define: local. No es sensible.
APP_ENV=local

# Requerido, secreto — generar con `php artisan key:generate`, nunca un valor real acá.
APP_KEY=

# Opcional — default si no se define: true en local. No es sensible.
APP_DEBUG=true

# Opcional — default si no se define: http://localhost. No es sensible.
APP_URL=http://localhost

# Opcional — zona usada solo para mostrar fechas; los instantes se guardan siempre en UTC.
APP_TIMEZONE=UTC
APP_LOCALE=es

# --- Base de datos ---
# Requerido. Sin estos valores la app tiene que fallar al iniciar, no arrancar a medias.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hurioscan
DB_USERNAME=
# Requerido, secreto.
DB_PASSWORD=

# --- Colas ---
# Requerido: el OCR corre en segundo plano y no puede ejecutarse de forma síncrona
# en producción. `database` usa la tabla de jobs que ya crea la migración base.
QUEUE_CONNECTION=database

# --- Almacenamiento de imágenes escaneadas ---
# Requerido. Disco de Laravel donde se guardan los originales digitalizados.
# Las imágenes no se guardan dentro de la base de datos.
FILESYSTEM_DISK=local

# --- OCR ---
# Requerido. Motor a usar: tesseract | paddleocr | vlm | nulo
# `nulo` devuelve texto vacío y sirve para desarrollo y tests sin motor instalado.
# Ver docs/integraciones/ocr.md
OCR_MOTOR=nulo

# Opcional — ruta del binario de Tesseract si OCR_MOTOR=tesseract.
OCR_TESSERACT_BIN=/opt/homebrew/bin/tesseract

# Opcional — URL del servicio HTTP de PaddleOCR si OCR_MOTOR=paddleocr.
OCR_PADDLE_URL=

# Requerido solo si OCR_MOTOR=vlm, secreto — nunca un valor real acá.
# Ver docs/integraciones/ocr.md
OCR_VLM_API_KEY=

# Opcional — modelo del proveedor de visión-lenguaje si OCR_MOTOR=vlm.
OCR_VLM_MODELO=

# --- Logs ---
# Opcional — default si no se define: stack. No es sensible.
LOG_CHANNEL=stack
LOG_LEVEL=debug
